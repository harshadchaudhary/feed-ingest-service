# Copy to .env and edit. Every value here is the default, so an empty .env
# is also valid.

# Storage. SQLite needs no server; swap in Postgres for the Compose stack.
FEED_DATABASE_URL=sqlite:///./feed_ingest.db

# Cache and distributed lock. Off by default: the service runs without Redis,
# and the lock then grants locally (single-instance behaviour).
FEED_REDIS_ENABLED=false
FEED_REDIS_URL=redis://localhost:6379/0
FEED_CACHE_TTL_SECONDS=60
FEED_LOCK_TTL_SECONDS=300

# Comma-separated feeds. Empty means the job is a no-op rather than an error.
FEED_FEED_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://hnrss.org/frontpage
FEED_FETCH_TIMEOUT_SECONDS=10
FEED_FETCH_MAX_ATTEMPTS=3
FEED_FETCH_BACKOFF_BASE_SECONDS=0.5

# Scheduling. 0 disables the in-process scheduler (use a K8s CronJob instead).
FEED_SCHEDULE_MINUTES=15
FEED_RUN_ON_STARTUP=false

# Webhook HMAC secret. MUST be changed for any real deployment.
FEED_WEBHOOK_SECRET=change-me
